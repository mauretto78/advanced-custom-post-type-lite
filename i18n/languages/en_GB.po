msgid ""
"The index \"{{index}}\" uses the column \"{{column}}\", which stores JSON. "
"MySQL cannot index a JSON column."
msgstr ""
"The index \"{{index}}\" uses the column \"{{column}}\", which stores JSON. "
"MySQL cannot index a JSON column."

msgid ""
"Remove \"{{column}}\" from the index, or change the column to a type that "
"can be indexed (for example INT or VARCHAR)."
msgstr ""
"Remove \"{{column}}\" from the index, or change the column to a type that "
"can be indexed (for example INT or VARCHAR)."

msgid ""
"The index \"{{index}}\" uses the column \"{{column}}\" ({{type}}). MySQL can "
"index this type only on its first characters."
msgstr ""
"The index \"{{index}}\" uses the column \"{{column}}\" ({{type}}). MySQL can "
"index this type only on its first characters."

msgid "Set a length on \"{{column}}\" in the index (for example 191)."
msgstr "Set a length on \"{{column}}\" in the index (for example 191)."

msgid ""
"The foreign key \"{{key}}\" links the column \"{{column}}\" ({{type}}) to "
"\"{{refColumn}}\" ({{refType}}) in the table \"{{refTable}}\". MySQL needs "
"both columns to have the same type."
msgstr ""
"The foreign key \"{{key}}\" links the column \"{{column}}\" ({{type}}) to "
"\"{{refColumn}}\" ({{refType}}) in the table \"{{refTable}}\". MySQL needs "
"both columns to have the same type."

msgid ""
"An index uses a column that stores JSON. MySQL cannot index a JSON column."
msgstr ""
"An index uses a column that stores JSON. MySQL cannot index a JSON column."

msgid ""
"Open the Indexes step and remove the JSON column from the index, or change "
"the column type."
msgstr ""
"Open the Indexes step and remove the JSON column from the index, or change "
"the column type."

msgid ""
"An index uses a text column without a length. MySQL can index this type only "
"on its first characters."
msgstr ""
"An index uses a text column without a length. MySQL can index this type only "
"on its first characters."

msgid ""
"Open the Indexes step and set a length on the text column (for example 191)."
msgstr ""
"Open the Indexes step and set a length on the text column (for example 191)."

msgid ""
"A foreign key links two columns MySQL cannot connect: they must have the "
"same type, and the referenced column must be a primary key or have a unique "
"index."
msgstr ""
"A foreign key links two columns MySQL cannot connect: they must have the "
"same type, and the referenced column must be a primary key or have a unique "
"index."

