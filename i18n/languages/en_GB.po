msgstr "Not created"

msgid ""
"The foreign key \"{{key}}\" empties the column \"{{column}}\" (SET NULL) "
"when the linked record changes, but the column does not allow empty values."
msgstr ""
"The foreign key \"{{key}}\" empties the column \"{{column}}\" (SET NULL) "
"when the linked record changes, but the column does not allow empty values."

msgid ""
"Allow empty values on \"{{column}}\" in the Columns step (Advanced Mode), or "
"choose another \"On delete\" / \"On update\" action."
msgstr ""
"Allow empty values on \"{{column}}\" in the Columns step (Advanced Mode), or "
"choose another \"On delete\" / \"On update\" action."

msgid ""
"In the Columns step, turn on Advanced Mode and change the type of "
"\"{{column}}\" to {{refType}}, or delete the foreign key."
msgstr ""
"In the Columns step, turn on Advanced Mode and change the type of "
"\"{{column}}\" to {{refType}}, or delete the foreign key."

msgid ""
"The column \"{{column}}\" ({{type}}) can't be linked to "
"\"{{refColumn}}\" ({{refType}}): MySQL needs both columns to have the same "
"type. In the Columns step, turn on Advanced Mode and change the type of "
"\"{{column}}\" to {{refType}}, or delete this foreign key."
msgstr ""
"The column \"{{column}}\" ({{type}}) can't be linked to "
"\"{{refColumn}}\" ({{refType}}): MySQL needs both columns to have the same "
"type. In the Columns step, turn on Advanced Mode and change the type of "
"\"{{column}}\" to {{refType}}, or delete this foreign key."

msgid ""
"\"SET NULL\" empties the column \"{{column}}\" when the linked record "
"changes, but the column doesn't allow empty values. Allow empty values on "
"\"{{column}}\" in the Columns step (Advanced Mode), or choose another action."
msgstr ""
"\"SET NULL\" empties the column \"{{column}}\" when the linked record "
"changes, but the column doesn't allow empty values. Allow empty values on "
"\"{{column}}\" in the Columns step (Advanced Mode), or choose another action."

msgid ""
"\"{{column}}\" stores JSON, and MySQL can't index JSON columns. Edit the key "
"parts to choose another column, or delete this index."
msgstr ""
"\"{{column}}\" stores JSON, and MySQL can't index JSON columns. Edit the key "
"parts to choose another column, or delete this index."

msgid ""
"\"{{column}}\" ({{type}}) can be indexed only on its first characters. Edit "
"the key parts and set a length (for example 191)."
msgstr ""
"\"{{column}}\" ({{type}}) can be indexed only on its first characters. Edit "
"the key parts and set a length (for example 191)."

