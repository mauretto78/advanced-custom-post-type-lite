{
    "name": "mauretto78/advanced-custom-post-type-lite",
    "type": "wordpress-plugin",
    "description": "ACPT Lite: create and manage custom post types, taxonomies and custom fields. The free version of ACPT.",
    "keywords": [
        "custom post type",
        "custom fields",
        "taxonomy",
        "wordpress"
    ],
    "homepage": "https://wordpress.org/plugins/acpt-lite/",
    "license": "GPL-3.0-or-later",
    "support": {
        "issues": "https://github.com/mauretto78/advanced-custom-post-type-lite/issues"
    },
    "authors": [
        {
            "name": "Mauro Cassani",
            "homepage": "https://github.com/mauretto78"
        }
    ],
    "autoload": {
        "psr-4": {
            "ACPT_Lite\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "appsero/client": "^1.2"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "ACPT_Lite\\Vendor\\",
            "classmap_prefix": "ACPT_Lite_Vendor_",
            "constant_prefix": "ACPT_LITE_VENDOR_",
            "functions_prefix": "acpt_lite_vendor_",
            "exclude_from_copy": {
                "packages": [
                    "appsero/client"
                ]
            },
            "delete_vendor_packages": true,
            "update_call_sites": false,
            "include_modified_date": false,
            "include_author": false
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "dev"
}
